{
    "image": "ghcr.io/skillrepos/ai-security-devcontainer:latest",
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/py_env/bin/python",
                "github.copilot.enable": {
                    "*": false,
                    "plaintext": false,
                    "markdown": false,
                    "scminput": false
                },
                "github.copilot.enableAutoComplete": false,
                "editor.inlineSuggest.enabled": false,
                "github.copilot.inlineSuggest.enable": false,
                "github.copilot.chat.enable": false,
                "github.copilotChat.showInExplorer": false,
                "workbench.startupEditor": "readme",
                "mergeInfo.skeletonHighlights": true,
                "mergeInfo.reviewHighlights": true,
                "workbench.editorAssociations": {
                    "*.md": "vscode.markdown.preview.editor"
                }
            },
            "extensions": [
                "mathematic.vscode-pdf"
            ]
        }
    },
    "postCreateCommand": "bash -i scripts/pysetup.sh py_env && bash -i scripts/startOllama.sh && py_env/bin/python scripts/warmup.py",
    "postAttachCommand": {
        "ollama": "bash scripts/post_attach_ollama.sh",
        "merge-info": "nohup bash -c 'for i in 1 2 3 4 5 6; do code --install-extension ${containerWorkspaceFolder}/.devcontainer/merge-info-0.3.0.vsix --force && break; sleep 10; done' >/tmp/merge-info-install.log 2>&1 &"
    }
}
